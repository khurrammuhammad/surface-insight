<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SurfaceInsight">
  <!-- Pill / capsule button: Background and BorderBrush come from the owner; hover is a translucent overlay. -->
  <Style x:Key="PillButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17"/>
        <Border x:Name="ov" Background="{DynamicResource HoverBrush}" CornerRadius="17" Opacity="0"/>
        <Border x:Name="focus" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="19" Margin="-2" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ov" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value=".75"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Row button: list rows and cards. Hover tint, focus ring, content stretches. -->
  <Style x:Key="RowButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14"/>
        <Border x:Name="ov" Background="{DynamicResource HoverBrush}" CornerRadius="14" Opacity="0"/>
        <Border x:Name="focus" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="14" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ov" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Opacity" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- iOS/macOS style switch -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Width="48" Height="28">
        <Border x:Name="track" CornerRadius="14" Background="{DynamicResource GridBrush}"/>
        <Border x:Name="focus" CornerRadius="16" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Opacity="0"/>
        <Border x:Name="knob" Width="22" Height="22" CornerRadius="11" Background="White" HorizontalAlignment="Left" Margin="3,0,0,0">
          <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity=".35"/></Border.Effect>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
          <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
          <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Slim overlay scrollbar -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2" CornerRadius="4" Background="{DynamicResource Text2Brush}" Opacity=".35"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
  </Style>

  <!-- Network lists: recycled rows with hover/selection tint -->
  <Style x:Key="NetItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Grid>
        <Border x:Name="bg" CornerRadius="12" Background="Transparent"/>
        <Border x:Name="focus" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SelBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Opacity" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NetList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource NetItem}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <DataTemplate x:Key="AppRowTemplate">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="DestRowTemplate">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="56"/><ColumnDefinition Width="96"/><ColumnDefinition Width="130"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/><ColumnDefinition Width="108"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="{Binding Host}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Port}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding Proto}" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="{Binding App}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
      <TextBlock Grid.Column="4" Text="{Binding Sent}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
      <TextBlock Grid.Column="5" Text="{Binding Recv}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
      <TextBlock Grid.Column="6" Text="{Binding Seen}" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="7" Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="LiveRowTemplate">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="56"/><ColumnDefinition Width="96"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="96"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Host}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Grid.Column="1" Text="{Binding Port}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding Proto}" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="{Binding Local}" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
      <TextBlock Grid.Column="4" Text="{Binding App}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
      <TextBlock Grid.Column="5" Text="{Binding State}" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="6" Text="{Binding Pid}" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
    </Grid>
  </DataTemplate>

  <!-- Network tree (applications > hostnames) -->
  <Style x:Key="NetTreeItem" TargetType="ListBoxItem" BasedOn="{StaticResource NetItem}">
    <Setter Property="Padding" Value="6,2"/>
  </Style>
  <Style x:Key="ChevronButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border Background="Transparent" Width="20" Height="24"><TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="NetAppNode">
    <Grid Height="36">
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
      <Button Tag="expand" Style="{StaticResource ChevronButton}" Content="{Binding Chevron}" Visibility="{Binding ChevronVisibility}" AutomationProperties.Name="Expand or collapse"/>
      <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Grid.Column="1" Text="&#xE8FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}"/>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,6,0">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <local:MiniBars Grid.Column="3" Up="{Binding Up}" Down="{Binding Down}" Act="{Binding Act}" Width="34" Height="24" VerticalAlignment="Center"/>
      <CheckBox Grid.Column="4" Tag="toggle" Style="{StaticResource Switch}" IsChecked="{Binding Allowed, Mode=OneWay}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToggleTip}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{Binding ToggleName}">
        <CheckBox.LayoutTransform><ScaleTransform ScaleX=".78" ScaleY=".78"/></CheckBox.LayoutTransform>
      </CheckBox>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="NetHostNode">
    <Grid Height="32" Margin="30,0,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
        <TextBlock Text="{Binding Host}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Text="{Binding SentText}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding RecvText}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="NetMoreNode">
    <Button Tag="more" Style="{StaticResource LinkButton}" Margin="52,4,0,4" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text}">
      <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
    </Button>
  </DataTemplate>
</ResourceDictionary>
